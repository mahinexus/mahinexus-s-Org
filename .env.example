# ============================================================================
# CAMPUSCORE STUDENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI API (auto-injected in AI Studio, optional for external hosting)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Supabase PostgreSQL & Auth Credentials
# Obtain these from your Supabase Project Settings -> API
# ----------------------------------------------------------------------------
# Project URL (Frontend & Backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Anonymous Public Key (Frontend safe, governed by Row Level Security)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service Role Secret Key (Backend ONLY - NEVER expose to client)
# Used for administrative automation, user provisioning, and secure batch operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
